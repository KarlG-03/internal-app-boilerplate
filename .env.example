# Docker Postgres (recommended local): docker compose up -d db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_boilerplate?schema=public

# API — copy to apps/api/.env for local Nest
PORT=2005
NODE_ENV=development
APP_NAME=My App

JWT_SECRET=dev-change-me-use-long-random-in-prod
JWT_EXPIRES_IN=7d

# Optional: machine-to-machine / scripts (X-API-Key header)
API_KEY=dev-change-me

# Comma-separated browser origins (web + admin)
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Email (optional locally)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=My App <onboarding@resend.dev>
# WEB_APP_URL=http://localhost:5173

# Admin bootstrap (first superadmin)
# ADMIN_BOOTSTRAP_SECRET=long-random-secret

# Web — apps/web/.env.local
# VITE_API_URL=
# VITE_APP_NAME=My App
# VITE_GOOGLE_CLIENT_ID=

# Admin — apps/admin/.env.local
# VITE_API_URL=
