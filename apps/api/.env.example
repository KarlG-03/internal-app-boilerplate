# Database
DATABASE_URL="postgresql://user:password@localhost:5432/loancompass"

# JWT Secrets
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-too"

# Google Sign-In (OAuth 2.0 Web client ID — same value as VITE_GOOGLE_CLIENT_ID on web)
GOOGLE_CLIENT_ID=""

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="LoanCompass <onboarding@resend.dev>"
WEB_APP_URL="http://localhost:5173"

# Stripe (Test Mode)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"

# Stripe Price IDs (Create these in Stripe Dashboard → Products)
STRIPE_PRO_PRICE_ID="price_xxxxxxxx"

# For Stripe CLI webhook forwarding (local development)
# Run: stripe listen --forward-to localhost:3001/api/billing/webhook
# This will give you the webhook secret to use above
