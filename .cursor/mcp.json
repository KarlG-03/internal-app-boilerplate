{
  "mcpServers": {
    "render": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.render.com/mcp",
        "--header",
        "Authorization: Bearer ${env:RENDER_API_KEY}"
      ],
      "envFile": "${workspaceFolder}/.env.render"
    }
  }
}
